# cognito-login-sample の環境変数。cp .env.example .env で複製し、
# terraform output の値で置き換えて使う
ADDR=:8080
AWS_REGION=ap-northeast-1
COGNITO_USER_POOL_ID=ap-northeast-1_XXXXXXXXX
COGNITO_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
COGNITO_CLIENT_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
MYSQL_DSN=appuser:apppass@tcp(127.0.0.1:3306)/cognito_login_sample?parseTime=true
COOKIE_SECURE=false
